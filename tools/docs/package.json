{
  "name": "@r10c/docs-check",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:shared",
      "type:testing"
    ],
    "sourceRoot": "tools/docs/src",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/vitest"
        ],
        "options": {
          "command": "vitest run --config vitest.config.mts",
          "cwd": "tools/docs"
        }
      }
    }
  },
  "devDependencies": {
    "@r10c/slices": "workspace:*"
  }
}
