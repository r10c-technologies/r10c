{
  "name": "@r10c/i18n-check",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:shared",
      "type:testing"
    ],
    "sourceRoot": "tools/i18n/src",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/vitest"
        ],
        "options": {
          "command": "vitest run --config vitest.config.mts",
          "cwd": "tools/i18n"
        }
      }
    }
  },
  "devDependencies": {
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/service-shell": "catalog:",
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-catalog-contracts": "workspace:*",
    "@r10c/business-ts-catalog-reference": "workspace:*",
    "@r10c/business-ts-common": "workspace:*",
    "@r10c/business-ts-configuration": "workspace:*",
    "@r10c/business-ts-order-management": "workspace:*",
    "@r10c/business-ts-payment-contracts": "workspace:*",
    "@r10c/business-ts-payment-management": "workspace:*",
    "@r10c/business-ts-product-configuration-management": "workspace:*",
    "@r10c/business-ts-flow-contracts": "workspace:*",
    "@r10c/business-ts-saga-contracts": "workspace:*",
    "@r10c/business-ts-sales-management": "workspace:*",
    "@r10c/business-ts-settlement-management": "workspace:*",
    "@r10c/business-ts-shipping-order-management": "workspace:*",
    "@r10c/business-ts-stock-management": "workspace:*",
    "@r10c/i18n-catalog": "workspace:*",
    "@r10c/slices": "workspace:*"
  }
}
