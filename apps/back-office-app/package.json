{
  "name": "@r10c/back-office-app",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@entifix/authz": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/i18n": "catalog:",
    "@entifix/jwt": "catalog:",
    "@entifix/next-i18n": "catalog:",
    "@entifix/next-shell": "catalog:",
    "@entifix/react-controls": "catalog:",
    "@entifix/react-integration": "catalog:",
    "@entifix/rest": "catalog:",
    "@entifix/style": "catalog:",
    "@r10c/business-ts-access-management": "workspace:*",
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-authz-grants": "workspace:*",
    "@r10c/business-ts-i18n": "workspace:*",
    "@r10c/i18n-catalog": "workspace:*",
    "@r10c/shells-next-auth": "workspace:*",
    "@r10c/shells-next-marketplace-admin": "workspace:*",
    "@r10c/shells-next-order": "workspace:*",
    "@r10c/shells-next-sales": "workspace:*",
    "@r10c/shells-next-settlement": "workspace:*",
    "@r10c/shells-next-stock": "workspace:*",
    "@r10c/shells-next-system-management": "workspace:*",
    "i18next": "26.5.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.4",
    "@r10c/utils-ts-fleet": "workspace:*"
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:back-office",
      "host:next"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "next dev -p 3001",
          "cwd": "apps/back-office-app"
        },
        "dependsOn": [
          "free-ports",
          "build-deps",
          {
            "projects": [
              "@r10c/source"
            ],
            "target": "watch-libs"
          },
          {
            "projects": [
              "@r10c/marketplace-admin-service",
              "@r10c/marketplace-service",
              "@r10c/auth-service",
              "@r10c/config-service",
              "@r10c/stock-service",
              "@r10c/sales-service",
              "@r10c/settlement-service",
              "@r10c/transaction-service"
            ],
            "target": "dev"
          }
        ]
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next start -p 3001",
          "cwd": "apps/back-office-app"
        }
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3001"
        }
      }
    }
  }
}
