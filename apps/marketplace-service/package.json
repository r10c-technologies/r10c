{
  "name": "@r10c/marketplace-service",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:marketplace",
      "host:effect"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--config-node-env=production"
          ],
          "cwd": "apps/marketplace-service"
        },
        "configurations": {
          "development": {
            "args": [
              "--config-node-env=development"
            ]
          }
        },
        "dependsOn": []
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/marketplace-service/dist/package.json",
          "{workspaceRoot}/apps/marketplace-service/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/marketplace-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "ensure-infra": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash infra/local/ensure.sh"
        }
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "free-ports",
          "build",
          "ensure-infra",
          {
            "projects": "@r10c/config-service",
            "target": "dev"
          }
        ],
        "options": {
          "buildTarget": "@r10c/marketplace-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@r10c/marketplace-service:build:development"
          },
          "production": {
            "buildTarget": "@r10c/marketplace-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3100"
        }
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "0.64.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-authz": "workspace:*",
    "@r10c/business-ts-catalog-reference": "workspace:*",
    "@r10c/business-ts-marketplace-catalog": "workspace:*",
    "@r10c/entifix-ts-business": "workspace:*",
    "@r10c/entifix-ts-core": "workspace:*",
    "@r10c/entifix-ts-jwt-client": "workspace:*",
    "@r10c/entifix-ts-mongo-client": "workspace:*",
    "@r10c/entifix-ts-tooling": "workspace:*",
    "@r10c/shells-effect-service": "workspace:*",
    "effect": "3.22.1",
    "jose": "6.2.8",
    "mongodb": "7.5.0",
    "tslib": "2.8.1"
  }
}
