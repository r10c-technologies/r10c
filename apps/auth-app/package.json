{
  "name": "@r10c/auth-app",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-authz": "workspace:*",
    "@r10c/entifix-react-controls": "workspace:*",
    "@r10c/entifix-style": "workspace:*",
    "@r10c/entifix-ts-core": "workspace:*",
    "@r10c/entifix-ts-i18n": "workspace:*",
    "@r10c/shells-next-common": "workspace:*",
    "@r10c/shells-next-i18n": "workspace:*",
    "effect": "3.22.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:auth"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "next dev -p 3002",
          "cwd": "apps/auth-app"
        },
        "dependsOn": [
          "free-ports",
          {
            "projects": [
              "@r10c/auth-service"
            ],
            "target": "dev"
          }
        ]
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next start -p 3002",
          "cwd": "apps/auth-app"
        }
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3002"
        }
      }
    }
  }
}
