{
  "name": "@r10c/auth-service",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:auth",
      "host:effect"
    ],
    "targets": {
      "ensure-infra": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash infra/local/ensure.sh"
        }
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "free-ports",
          "build",
          "ensure-infra",
          {
            "projects": "@r10c/config-service",
            "target": "dev"
          }
        ],
        "options": {
          "buildTarget": "@r10c/auth-service:build",
          "runBuildTargetDependencies": false,
          "port": 9102,
          "runtimeArgs": [
            "--disable-warning=DEP0205"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "@r10c/auth-service:build:development"
          },
          "production": {
            "buildTarget": "@r10c/auth-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "build": {
        "dependsOn": []
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3102 9102"
        }
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@r10c/business-ts-authn": "workspace:*",
    "@entifix/authz": "catalog:",
    "@r10c/business-ts-authz-grants": "workspace:*",
    "@r10c/business-ts-i18n": "workspace:*",
    "@r10c/business-ts-party-management": "workspace:*",
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/i18n": "catalog:",
    "@entifix/jwt": "catalog:",
    "@entifix/mongo": "catalog:",
    "@entifix/redis": "catalog:",
    "@entifix/tooling": "catalog:",
    "@entifix/zitadel": "catalog:",
    "@entifix/service-shell": "catalog:",
    "effect": "4.0.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "tslib": "2.8.1",
    "@r10c/utils-ts-fleet": "workspace:*"
  }
}
