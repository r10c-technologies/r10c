{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "target": "es2022",
    "experimentalDecorators": false,
    "importHelpers": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../packages/business/ts/stock-management/tsconfig.lib.json"
    },
    {
      "path": "../../packages/business/ts/authz-grants/tsconfig.lib.json"
    },
    {
      "path": "../../packages/business/ts/authn/tsconfig.lib.json"
    }
  ]
}
