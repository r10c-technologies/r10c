{
  "name": "@r10c/settlement-service",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:settlement",
      "host:effect"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [],
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--config-node-env=production"
          ],
          "cwd": "apps/settlement-service"
        },
        "configurations": {
          "development": {
            "args": [
              "--config-node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/settlement-service/dist/package.json",
          "{workspaceRoot}/apps/settlement-service/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/settlement-service/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/settlement-service/dist/patches",
          "{workspaceRoot}/apps/settlement-service/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ]
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/settlement-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "ensure-infra": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash infra/local/ensure.sh"
        }
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "free-ports",
          "build",
          "ensure-infra",
          {
            "projects": "@r10c/config-service",
            "target": "dev"
          }
        ],
        "options": {
          "buildTarget": "@r10c/settlement-service:build",
          "runBuildTargetDependencies": false,
          "port": 9107,
          "runtimeArgs": [
            "--disable-warning=DEP0205"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "@r10c/settlement-service:build:development"
          },
          "production": {
            "buildTarget": "@r10c/settlement-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3107 9107"
        }
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@entifix/amqp": "catalog:",
    "@entifix/authz": "catalog:",
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/jwt": "catalog:",
    "@entifix/mongo": "catalog:",
    "@entifix/service-shell": "catalog:",
    "@entifix/tooling": "catalog:",
    "@entifix/transactions": "catalog:",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-authz-grants": "workspace:*",
    "@r10c/business-ts-payment-contracts": "workspace:*",
    "@r10c/business-ts-sales-vocabulary": "workspace:*",
    "@r10c/business-ts-settlement-management": "workspace:*",
    "@r10c/implementation-settlement-management-http": "workspace:*",
    "@r10c/implementation-settlement-mongo": "workspace:*",
    "@r10c/shells-effect-service": "workspace:*",
    "@r10c/utils-ts-fleet": "workspace:*",
    "effect": "4.0.5",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@entifix/testing-unit": "catalog:"
  }
}
