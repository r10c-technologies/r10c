{
  "name": "@r10c/payment-service-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:e2e",
      "scope:payment"
    ],
    "implicitDependencies": [
      "@r10c/payment-service"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/vitest"
        ],
        "options": {
          "command": "vitest run --config vitest.config.mts --passWithNoTests",
          "cwd": "apps/payment-service-e2e"
        }
      }
    }
  },
  "devDependencies": {
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-party-management": "workspace:*",
    "@r10c/business-ts-payment-management": "workspace:*",
    "@entifix/business": "catalog:",
    "@entifix/jwt": "catalog:",
    "@entifix/testing-e2e": "catalog:",
    "@r10c/payment-service": "workspace:*",
    "@entifix/service-shell": "catalog:"
  },
  "dependencies": {
    "@entifix/authz": "catalog:",
    "@r10c/business-ts-authz-grants": "workspace:*"
  }
}
