{
  "name": "@r10c/marketplace-app",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@r10c/entifix-react-controls": "workspace:*",
    "@r10c/entifix-style": "workspace:*",
    "@r10c/entifix-ts-i18n": "workspace:*",
    "@r10c/shells-next-common": "workspace:*",
    "@r10c/shells-next-marketplace": "workspace:*",
    "@r10c/shells-next-i18n": "workspace:*",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:marketplace",
      "host:next"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "next dev -p 3000",
          "cwd": "apps/marketplace-app"
        },
        "dependsOn": [
          "free-ports",
          "build-deps",
          {
            "projects": [
              "@r10c/marketplace-service"
            ],
            "target": "dev"
          },
          {
            "projects": [
              "@r10c/source"
            ],
            "target": "watch-libs"
          }
        ]
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next start -p 3000",
          "cwd": "apps/marketplace-app"
        }
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3000"
        }
      }
    }
  }
}
