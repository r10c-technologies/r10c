{
  "name": "@r10c/marketplace-app",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@entifix/i18n": "catalog:",
    "@entifix/next-i18n": "catalog:",
    "@entifix/next-shell": "catalog:",
    "@entifix/react-controls": "catalog:",
    "@entifix/style": "catalog:",
    "@r10c/business-ts-i18n": "workspace:*",
    "@r10c/i18n-catalog": "workspace:*",
    "@r10c/shells-next-marketplace": "workspace:*",
    "i18next": "26.5.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "@r10c/utils-ts-fleet": "workspace:*"
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:marketplace",
      "host:next"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "next dev -p 3000",
          "cwd": "apps/marketplace-app"
        },
        "dependsOn": [
          "free-ports",
          "build-deps",
          {
            "projects": [
              "@r10c/marketplace-service",
              "@r10c/marketplace-admin-service"
            ],
            "target": "dev"
          },
          {
            "projects": [
              "@r10c/source"
            ],
            "target": "watch-libs"
          }
        ]
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next start -p 3000",
          "cwd": "apps/marketplace-app"
        }
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3000"
        }
      }
    }
  }
}
