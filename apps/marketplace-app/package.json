{
  "name": "@r10c/marketplace-app",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@entifix/i18n": "catalog:",
    "@entifix/next-i18n": "catalog:",
    "@entifix/next-shell": "catalog:",
    "@entifix/react-controls": "catalog:",
    "@entifix/react-integration": "catalog:",
    "@entifix/style": "catalog:",
    "@r10c/business-ts-i18n": "workspace:*",
    "@r10c/i18n-catalog": "workspace:*",
    "@r10c/shells-next-marketplace": "workspace:*",
    "@r10c/utils-ts-fleet": "workspace:*",
    "i18next": "27.2.2",
    "next": "16.4.6",
    "posthog-js": "1.453.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "nx": {
    "tags": [
      "layer:app",
      "scope:marketplace",
      "host:next"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "next dev -p 3200",
          "cwd": "apps/marketplace-app"
        },
        "dependsOn": [
          "free-ports",
          "build-deps",
          {
            "projects": [
              "@r10c/marketplace-service",
              "@r10c/marketplace-admin-service",
              "@r10c/auth-service",
              "@r10c/realtime-service",
              "@r10c/transaction-service",
              "@r10c/stock-service",
              "@r10c/order-service",
              "@r10c/payment-service",
              "@r10c/fulfilment-service"
            ],
            "target": "dev"
          },
          {
            "projects": [
              "@r10c/edge"
            ],
            "target": "serve"
          },
          {
            "projects": [
              "@r10c/source"
            ],
            "target": "watch-libs"
          }
        ]
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next start -p 3200",
          "cwd": "apps/marketplace-app"
        }
      },
      "free-ports": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/free-ports.sh 3200"
        }
      },
      "container": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -f tools/docker/next.Dockerfile --build-arg APP=marketplace-app -t r10c/marketplace-app:local apps/marketplace-app"
        }
      }
    }
  }
}
