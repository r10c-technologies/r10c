{
  "name": "@r10c/storefront-storybook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:storybook",
      "scope:marketplace"
    ],
    "sourceRoot": "apps/storefront-storybook/src",
    "targets": {
      "storybook": {
        "command": "storybook dev -p 6006 --no-open",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "build-storybook": {
        "command": "storybook build --quiet",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/storybook-static"
        ],
        "cache": true,
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@entifix/react-controls": "catalog:",
    "@entifix/style": "catalog:",
    "@r10c/business-ts-marketplace-catalog": "workspace:*",
    "@r10c/business-ts-catalog-reference": "workspace:*",
    "@r10c/testing-catalog-fixtures": "workspace:*",
    "@r10c/utils-react-ui": "workspace:*",
    "effect": "4.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "storybook": "10.6.2"
  }
}
