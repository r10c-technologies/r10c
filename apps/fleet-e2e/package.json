{
  "name": "@r10c/fleet-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:e2e",
      "scope:shared"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/vitest"
        ],
        "options": {
          "command": "vitest run --config vitest.config.mts --passWithNoTests",
          "cwd": "apps/fleet-e2e"
        }
      }
    }
  },
  "devDependencies": {
    "@entifix/jwt": "catalog:",
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/utils-ts-fleet": "workspace:*",
    "mongodb": "7.8.0"
  }
}
