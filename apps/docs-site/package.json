{
  "name": "@r10c/docs-site",
  "version": "0.0.1",
  "private": true,
  "description": "The documentation site: one page per use case from the capability register with the entities it touches drawn from their own metadata, the service catalog and the store map from the slice register, exported as static files and searched with Pagefind.",
  "dependencies": {
    "@entifix/authz": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/docs-engine": "catalog:",
    "@entifix/i18n": "catalog:",
    "@entifix/react-controls": "catalog:",
    "@entifix/style": "catalog:",
    "@r10c/business-ts-access-management": "workspace:*",
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-authz-grants": "workspace:*",
    "@r10c/business-ts-catalog-reference": "workspace:*",
    "@r10c/business-ts-configuration": "workspace:*",
    "@r10c/business-ts-i18n": "workspace:*",
    "@r10c/business-ts-marketplace-catalog": "workspace:*",
    "@r10c/business-ts-marketplace-vendor": "workspace:*",
    "@r10c/business-ts-order-management": "workspace:*",
    "@r10c/business-ts-party-management": "workspace:*",
    "@r10c/business-ts-payment-management": "workspace:*",
    "@r10c/business-ts-product-configuration-management": "workspace:*",
    "@r10c/business-ts-sales-management": "workspace:*",
    "@r10c/business-ts-settlement-management": "workspace:*",
    "@r10c/business-ts-shipping-order-management": "workspace:*",
    "@r10c/business-ts-stock-management": "workspace:*",
    "@r10c/capabilities": "workspace:*",
    "@r10c/slices": "workspace:*",
    "@xyflow/react": "13.0.2",
    "fumadocs-ui": "16.19.5",
    "i18next": "27.2.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "devDependencies": {
    "pagefind": "1.6.0"
  },
  "nx": {
    "tags": [
      "layer:docs",
      "scope:shared",
      "host:next"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build",
          "^typecheck",
          {
            "projects": [
              "@r10c/storefront-storybook"
            ],
            "target": "build-storybook"
          },
          {
            "projects": [
              "@r10c/docs-reference"
            ],
            "target": "generate"
          }
        ],
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "next",
              "pagefind"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/out"
        ],
        "cache": true,
        "options": {
          "command": "next build --webpack && node finish.mjs",
          "cwd": "apps/docs-site",
          "forwardAllArgs": false
        }
      },
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@r10c/docs-reference"
            ],
            "target": "generate"
          }
        ],
        "options": {
          "command": "next dev -p 3220 --webpack",
          "cwd": "apps/docs-site",
          "forwardAllArgs": false
        }
      },
      "serve-static": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "node serve.mjs",
          "cwd": "apps/docs-site"
        }
      },
      "test": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@r10c/docs-reference"
            ],
            "target": "generate"
          }
        ]
      },
      "container": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t r10c/docs-site:local apps/docs-site",
          "forwardAllArgs": false
        }
      }
    }
  }
}
