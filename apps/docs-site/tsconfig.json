{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "out",
    "node_modules",
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    ".next",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../tools/slices"
    },
    {
      "path": "../../tools/capabilities"
    },
    {
      "path": "../../packages/business/ts/stock-management"
    },
    {
      "path": "../../packages/business/ts/shipping-order-management"
    },
    {
      "path": "../../packages/business/ts/settlement-management"
    },
    {
      "path": "../../packages/business/ts/sales-management"
    },
    {
      "path": "../../packages/business/ts/product-configuration-management"
    },
    {
      "path": "../../packages/business/ts/payment-management"
    },
    {
      "path": "../../packages/business/ts/party-management"
    },
    {
      "path": "../../packages/business/ts/order-management"
    },
    {
      "path": "../../packages/business/ts/marketplace-vendor"
    },
    {
      "path": "../../packages/business/ts/marketplace-catalog"
    },
    {
      "path": "../../packages/business/ts/i18n"
    },
    {
      "path": "../../packages/business/ts/configuration"
    },
    {
      "path": "../../packages/business/ts/catalog-reference"
    },
    {
      "path": "../../packages/business/ts/authz-grants"
    },
    {
      "path": "../../packages/business/ts/authn"
    },
    {
      "path": "../../packages/business/ts/access-management"
    }
  ]
}
