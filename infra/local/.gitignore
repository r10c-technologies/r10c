# Local infra credentials — never commit real secret material.
# Each platform ships a committed .env.example; developers copy it to .env
# (done automatically by apply.sh). The real .env stays out of git.
**/.env

# Extracted from the running instance by the L6/L7 rungs, and regenerated from
# scratch on every reset because the instance they describe is. `.pat` is the
# seed's machine token and `.login-client.pat` the hosted login's, both minted by
# Zitadel at first init; `.generated.env` is what the seed discovered (the OIDC
# client id) and what config-service reads at boot.
zitadel/.pat
zitadel/.login-client.pat
zitadel/.generated.env
