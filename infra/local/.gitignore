# Local infra credentials — never commit real secret material.
# Each platform ships a committed .env.example; developers copy it to .env
# (done automatically by apply.sh). The real .env stays out of git.
**/.env

# Generated by the L6 Zitadel seed rung, and regenerated from scratch on every
# reset because the instance they describe is. `.pat` is the machine token
# Zitadel minted at first init; `.generated.env` is what the seed discovered
# (the OIDC client id) and what config-service reads at boot.
zitadel/.pat
zitadel/.generated.env
