# LOCAL DEV ONLY — do not reuse these credentials anywhere real.
#
# ZITADEL_MASTERKEY is NOT listed here — apply.sh generates a random 32-char
# key into the real .env on first run. Never commit the master key.
#
# Admin connection password — must match postgres/.env POSTGRES_PASSWORD.
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=postgres
# Password Zitadel sets for the app db user it creates on init.
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=zitadel
# First-instance console admin login (username is set in the deployment).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=Password1!

# --- Social sign-in (optional) ----------------------------------------------
# Google is wired by `tools/zitadel-seed.mjs` only when BOTH values below are
# non-empty; otherwise the seed logs that it skipped the provider and everything
# else still works. Real OAuth credentials cannot be committed, so obtaining a
# pair from the Google Cloud console is a per-developer step:
#
#   Authorised redirect URI:
#     http://localhost:30080/ui/login/login/externalidp/callback
#
# Leaving these blank is the supported default — sign-in with a password and
# TOTP does not depend on them.
R10C_GOOGLE_CLIENT_ID=
R10C_GOOGLE_CLIENT_SECRET=

# Mail goes to the Mailpit deployment in the same namespace (SMTP mailpit:1025,
# inbox at http://localhost:30826). Configured through Zitadel's API by the seed
# rung, not here, because it is instance state rather than process config.
