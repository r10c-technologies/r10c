#!/bin/sh

echo "┏━━━ husky: pre-commit ━━━━━━━━━━━━━━"

git fetch --all -p
pnpm exec lint-staged --relative

# The generated documentation blocks. ~1s, no network, no LLM. Runs after
# lint-staged so it compares against the formatted files rather than fighting
# Prettier over table alignment.
node tools/sync-docs.mjs --check

# A commit built on an entifix `dev-sync` copy passes here and fails in CI, which
# installs the pinned release. ENTIFIX_DEV_SYNC_OK=1 lets one through on purpose.
node tools/conventions/entifix-dev-sync.mjs

pnpm nx affected --target=lint,build --base=origin/main --head=HEAD