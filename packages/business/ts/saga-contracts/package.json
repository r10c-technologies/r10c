{
  "name": "@r10c/business-ts-saga-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "layer:business",
      "business:policy",
      "scope:shared"
    ],
    "sourceRoot": "packages/business/ts/saga-contracts/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/business/ts/saga-contracts/dist",
          "main": "packages/business/ts/saga-contracts/src/index.ts",
          "tsConfig": "packages/business/ts/saga-contracts/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "@entifix/core": "catalog:",
    "effect": "4.0.5"
  }
}
