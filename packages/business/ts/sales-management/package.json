{
  "name": "@r10c/business-ts-sales-management",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "layer:business",
      "business:domain",
      "scope:shared"
    ],
    "sourceRoot": "packages/business/ts/sales-management/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/business/ts/sales-management/dist",
          "main": "packages/business/ts/sales-management/src/index.ts",
          "tsConfig": "packages/business/ts/sales-management/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/authz": "catalog:",
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@r10c/business-ts-catalog-contracts": "workspace:*",
    "@r10c/business-ts-saga-contracts": "workspace:*",
    "@r10c/business-ts-sales-vocabulary": "workspace:*",
    "@swc/helpers": "0.5.23",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@entifix/testing-unit": "catalog:"
  }
}
