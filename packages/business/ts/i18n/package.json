{
  "name": "@r10c/business-ts-i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!**/*.tsbuildinfo"],
  "nx": {
    "tags": ["layer:business", "business:policy", "scope:shared"],
    "sourceRoot": "packages/business/ts/i18n/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "packages/business/ts/i18n/dist",
          "main": "packages/business/ts/i18n/src/index.ts",
          "tsConfig": "packages/business/ts/i18n/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  }
}
