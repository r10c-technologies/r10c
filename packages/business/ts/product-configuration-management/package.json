{
  "name": "@r10c/business-ts-product-configuration-management",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@r10c/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "layer:business",
      "business:domain",
      "scope:shared"
    ],
    "sourceRoot": "packages/business/ts/product-configuration-management/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/business/ts/product-configuration-management/dist",
          "main": "packages/business/ts/product-configuration-management/src/index.ts",
          "tsConfig": "packages/business/ts/product-configuration-management/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/authz": "catalog:",
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/transactions": "catalog:",
    "@r10c/business-ts-catalog-contracts": "workspace:*",
    "@swc/helpers": "0.5.23",
    "effect": "4.0.6"
  },
  "peerDependencies": {
    "vitest": "5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@entifix/testing-unit": "catalog:",
    "vitest": "5.0.5"
  }
}
