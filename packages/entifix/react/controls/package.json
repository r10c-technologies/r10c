{
  "name": "@r10c/entifix-react-controls",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@r10c/entifix-ts-core": "workspace:*",
    "@r10c/entifix-ts-i18n": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "effect": "3.22.0",
    "i18next": "26.3.6",
    "react-i18next": "17.0.11"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@r10c/entifix-style": "workspace:*",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-themes": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "storybook": "^10.5.3"
  },
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:react"
    ],
    "sourceRoot": "packages/entifix/react/controls/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix/react/controls/dist",
          "main": "packages/entifix/react/controls/src/index.ts",
          "tsConfig": "packages/entifix/react/controls/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      },
      "storybook": {
        "command": "storybook dev -p 6006 --no-open",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "build-storybook": {
        "command": "storybook build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      }
    }
  }
}
