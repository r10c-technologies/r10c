{
  "name": "@r10c/entifix-react-integration",
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:react",
      "tier:3"
    ],
    "sourceRoot": "packages/entifix/react/integration/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix/react/integration/dist",
          "main": "packages/entifix/react/integration/src/index.ts",
          "tsConfig": "packages/entifix/react/integration/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@r10c/entifix-transactions": "workspace:*",
    "@r10c/entifix-ts-business": "workspace:*",
    "@r10c/entifix-ts-core": "workspace:*",
    "@r10c/entifix-ts-i18n": "workspace:*"
  },
  "devDependencies": {
    "@r10c/entifix-ts-testing-unit": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-i18next": "17.0.11"
  },
  "peerDependencies": {
    "@tanstack/react-form": ">=1.33 <2",
    "@tanstack/react-query": ">=5.101 <6",
    "effect": ">=3.22 <4",
    "react": ">=19 <20",
    "react-i18next": ">=17 <18"
  }
}
