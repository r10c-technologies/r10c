{
  "name": "@r10c/shells-next-common",
  "nx": {
    "tags": [
      "layer:shell",
      "scope:shared",
      "shell:base",
      "tier:4"
    ],
    "sourceRoot": "packages/entifix/next/shell/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix/next/shell/dist",
          "main": "packages/entifix/next/shell/src/index.ts",
          "tsConfig": "packages/entifix/next/shell/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@r10c/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "devDependencies": {
    "@r10c/entifix-ts-testing-unit": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "effect": "3.22.1",
    "i18next": "26.3.6",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@r10c/business-ts-authz": "workspace:*",
    "@r10c/entifix-react-controls": "workspace:*",
    "@r10c/entifix-react-integration": "workspace:*",
    "@r10c/entifix-transactions": "workspace:*",
    "@r10c/entifix-ts-business": "workspace:*",
    "@r10c/entifix-ts-core": "workspace:*",
    "@r10c/entifix-ts-i18n": "workspace:*",
    "idb": "^8.0.3"
  },
  "files": [],
  "peerDependencies": {
    "@tanstack/react-query": ">=5.101 <6",
    "effect": ">=3.22 <4",
    "i18next": ">=26 <27",
    "next": ">=16 <17",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "zustand": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    }
  }
}
