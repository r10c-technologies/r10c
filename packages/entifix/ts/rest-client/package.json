{
  "name": "@entifix/rest",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@entifix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:client",
      "tier:2"
    ],
    "sourceRoot": "packages/entifix/ts/rest-client/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix/ts/rest-client/dist",
          "main": "packages/entifix/ts/rest-client/src/index.ts",
          "tsConfig": "packages/entifix/ts/rest-client/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/transactions": "workspace:*",
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "devDependencies": {
    "@entifix/testing-unit": "workspace:*",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "effect": ">=3.22 <4"
  }
}
