{
  "name": "@r10c/entifix-ts-mongo-client",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transactions": {
      "@r10c/source": "./src/transactions/index.ts",
      "types": "./dist/transactions/index.d.ts",
      "import": "./dist/transactions/index.js",
      "default": "./dist/transactions/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:client",
      "runtime:datastore",
      "tier:2"
    ],
    "sourceRoot": "packages/entifix/ts/mongo-client/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix/ts/mongo-client/dist",
          "main": "packages/entifix/ts/mongo-client/src/index.ts",
          "tsConfig": "packages/entifix/ts/mongo-client/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@r10c/entifix-ts-business": "workspace:*",
    "@r10c/entifix-ts-core": "workspace:*",
    "@swc/helpers": "0.5.23",
    "mongodb": "7.5.0"
  },
  "devDependencies": {
    "@r10c/entifix-transactions": "workspace:*",
    "@r10c/entifix-ts-testing-unit": "workspace:*",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "@r10c/entifix-transactions": "workspace:*",
    "effect": ">=3.22 <4"
  },
  "peerDependenciesMeta": {
    "@r10c/entifix-transactions": {
      "optional": true
    }
  }
}
