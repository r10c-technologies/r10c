{
  "name": "@r10c/business-ts-authz",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "layer:entifix",
      "scope:shared",
      "entifix:contract",
      "tier:4"
    ],
    "sourceRoot": "packages/entifix/ts/authz/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix/ts/authz/dist",
          "main": "packages/entifix/ts/authz/src/index.ts",
          "tsConfig": "packages/entifix/ts/authz/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@r10c/entifix-ts-core": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "peerDependencies": {
    "effect": ">=3.22 <4"
  },
  "devDependencies": {
    "effect": "3.22.1"
  }
}
