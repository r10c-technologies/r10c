{
  "name": "@r10c/shells-effect-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "layer:shell",
      "scope:shared",
      "shell:base",
      "tier:4"
    ],
    "sourceRoot": "packages/entifix/effect/service-shell/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix/effect/service-shell/dist",
          "main": "packages/entifix/effect/service-shell/src/index.ts",
          "tsConfig": "packages/entifix/effect/service-shell/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "0.64.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@r10c/business-ts-authz": "workspace:*",
    "@r10c/entifix-ts-business": "workspace:*",
    "@r10c/entifix-ts-core": "workspace:*",
    "@r10c/entifix-ts-tooling": "workspace:*",
    "@swc/helpers": "0.5.23"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@r10c/entifix-ts-testing-unit": "workspace:*",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9 <2",
    "effect": ">=3.22 <4"
  }
}
