{
  "name": "@r10c/utils-react-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "layer:utils",
      "scope:shared",
      "tech:react"
    ],
    "sourceRoot": "packages/utils/react/ui/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/utils/react/ui/dist",
          "main": "packages/utils/react/ui/src/index.ts",
          "tsConfig": "packages/utils/react/ui/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/react-controls": "catalog:",
    "@swc/helpers": "0.5.23"
  },
  "peerDependencies": {
    "react": "19.3.1"
  }
}
