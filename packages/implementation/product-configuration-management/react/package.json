{
  "name": "@r10c/implementation-product-configuration-management-react",
  "nx": {
    "tags": [
      "layer:implementation",
      "scope:shared"
    ],
    "sourceRoot": "packages/implementation/product-configuration-management/react/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/implementation/product-configuration-management/react/dist",
          "main": "packages/implementation/product-configuration-management/react/src/index.ts",
          "tsConfig": "packages/implementation/product-configuration-management/react/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@r10c/entifix-ts-testing-unit": "workspace:*"
  },
  "dependencies": {
    "@r10c/business-ts-catalog-reference": "workspace:*"
  }
}
