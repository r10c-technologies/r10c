{
  "name": "@r10c/shells-next-auth",
  "nx": {
    "tags": [
      "layer:shell",
      "scope:auth",
      "shell:domain"
    ],
    "sourceRoot": "packages/shells/next/auth/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/shells/next/auth/dist",
          "main": "packages/shells/next/auth/src/index.ts",
          "tsConfig": "packages/shells/next/auth/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@r10c/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "dependencies": {
    "@r10c/business-ts-authn": "workspace:*",
    "@r10c/business-ts-authz": "workspace:*",
    "@r10c/entifix-react-controls": "workspace:*",
    "@r10c/entifix-ts-core": "workspace:*",
    "@r10c/shells-next-common": "workspace:*",
    "@r10c/shells-next-i18n": "workspace:*"
  }
}
