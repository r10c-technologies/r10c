{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es2022", "decorators", "esnext.decorators", "dom", "dom.iterable"],
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "next",
      "@nx/next/typings/image.d.ts"
    ],
    "rootDir": "src",
    "jsx": "react-jsx",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../../utils/react/ui/tsconfig.lib.json"
    },
    {
      "path": "../../../utils/ts/fleet/tsconfig.lib.json"
    },
    {
      "path": "../../../implementation/marketplace-catalog/next/tsconfig.lib.json"
    },
    {
      "path": "../../../implementation/catalog-reference/next/tsconfig.lib.json"
    },
    {
      "path": "../../../business/ts/marketplace-catalog/tsconfig.lib.json"
    },
    {
      "path": "../../../business/ts/catalog-reference/tsconfig.lib.json"
    }
  ]
}
