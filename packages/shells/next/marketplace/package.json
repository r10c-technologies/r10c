{
  "name": "@r10c/shells-next-marketplace",
  "nx": {
    "tags": [
      "layer:shell",
      "scope:marketplace",
      "shell:domain"
    ],
    "sourceRoot": "packages/shells/next/marketplace/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/shells/next/marketplace/dist",
          "main": "packages/shells/next/marketplace/src/index.ts",
          "tsConfig": "packages/shells/next/marketplace/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@r10c/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "dependencies": {
    "@r10c/business-ts-catalog-reference": "workspace:*",
    "@r10c/business-ts-marketplace-catalog": "workspace:*",
    "@r10c/business-ts-marketplace-vendor": "workspace:*",
    "@entifix/react-controls": "catalog:",
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/i18n": "catalog:",
    "@entifix/rest": "catalog:",
    "effect": "4.0.5",
    "@r10c/implementation-catalog-reference-next": "workspace:*",
    "@r10c/implementation-marketplace-catalog-next": "workspace:*",
    "@r10c/implementation-marketplace-vendor-next": "workspace:*",
    "@r10c/utils-ts-fleet": "workspace:*",
    "@r10c/utils-react-ui": "workspace:*"
  },
  "devDependencies": {
    "@entifix/testing-unit": "catalog:"
  }
}
