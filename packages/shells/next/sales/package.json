{
  "name": "@r10c/shells-next-sales",
  "nx": {
    "tags": [
      "layer:shell",
      "scope:sales",
      "shell:domain"
    ],
    "sourceRoot": "packages/shells/next/sales/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/shells/next/sales/dist",
          "main": "packages/shells/next/sales/src/index.ts",
          "tsConfig": "packages/shells/next/sales/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@r10c/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "dependencies": {
    "@entifix/react-controls": "workspace:*",
    "@r10c/business-ts-marketplace-catalog": "workspace:*",
    "@entifix/authz": "workspace:*",
    "@r10c/business-ts-sales-management": "workspace:*",
    "@entifix/react-integration": "workspace:*",
    "@entifix/business": "workspace:*",
    "@entifix/core": "workspace:*",
    "@entifix/rest": "workspace:*",
    "@entifix/next-shell": "workspace:*",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@r10c/business-ts-i18n": "workspace:*",
    "@entifix/testing-unit": "workspace:*"
  }
}
