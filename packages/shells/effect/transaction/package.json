{
  "name": "@r10c/shells-effect-transaction",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "layer:shell",
      "scope:transaction",
      "shell:platform"
    ],
    "sourceRoot": "packages/shells/effect/transaction/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/shells/effect/transaction/dist",
          "main": "packages/shells/effect/transaction/src/index.ts",
          "tsConfig": "packages/shells/effect/transaction/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/amqp": "catalog:",
    "@entifix/authz": "catalog:",
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/mongo": "catalog:",
    "@entifix/service-shell": "catalog:",
    "@entifix/transactions": "catalog:",
    "@r10c/business-ts-saga-contracts": "workspace:*",
    "@r10c/implementation-saga-mongo": "workspace:*",
    "@r10c/shells-effect-service": "workspace:*",
    "@swc/helpers": "0.5.23",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@entifix/testing-unit": "catalog:",
    "@r10c/shells-effect-flow-catalog": "workspace:*",
    "@r10c/testing-http": "workspace:*"
  }
}
