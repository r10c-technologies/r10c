{
  "name": "@r10c/shells-effect-settlement",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@r10c/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "layer:shell",
      "scope:settlement",
      "shell:domain"
    ],
    "sourceRoot": "packages/shells/effect/settlement/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/shells/effect/settlement/dist",
          "main": "packages/shells/effect/settlement/src/index.ts",
          "tsConfig": "packages/shells/effect/settlement/tsconfig.lib.json",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/amqp": "catalog:",
    "@entifix/business": "catalog:",
    "@entifix/mongo": "catalog:",
    "@entifix/service-shell": "catalog:",
    "@entifix/transactions": "catalog:",
    "@r10c/business-ts-payment-contracts": "workspace:*",
    "@r10c/business-ts-settlement-management": "workspace:*",
    "@r10c/implementation-settlement-management-http": "workspace:*",
    "@r10c/implementation-settlement-mongo": "workspace:*",
    "@r10c/shells-effect-service": "workspace:*",
    "@swc/helpers": "0.5.23",
    "effect": "4.0.6",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@entifix/core": "catalog:",
    "@entifix/testing-unit": "catalog:"
  }
}
